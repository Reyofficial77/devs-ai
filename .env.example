# === Supabase ===
# Ambil di Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_dengan_anon_public_key

# === Google Gemini ===
# Ambil di https://aistudio.google.com/apikey
# GEMINI_API_KEY wajib diisi. GEMINI_API_KEY_2 dan GEMINI_API_KEY_3 opsional —
# kalau diisi, sistem otomatis beralih ke key berikutnya kalau key sebelumnya kena limit kuota.
# Disarankan buat 3 API key dari akun Google berbeda supaya kuota gratisnya benar-benar terpisah.
GEMINI_API_KEY=isi_dengan_gemini_api_key_1
GEMINI_API_KEY_2=isi_dengan_gemini_api_key_2
GEMINI_API_KEY_3=isi_dengan_gemini_api_key_3

# === App ===
# URL aplikasi kamu (dipakai untuk redirect OAuth). Saat development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
